# OnlyOrders external-service API base (api2 or the web /api proxy both work)
ONLYORDERS_API_BASE=https://onlyorders.tech/api2/ext-service

# Optional: reuse an existing external service (one that already has a connected
# Facebook channel). Leave blank to have the server create a new service on boot.
ONLYORDERS_SERVICE_ID=

# Public webhook URL that OnlyOrders should POST to. Set this to the Cloudflare
# quick-tunnel URL once the tunnel is up, then restart or call /register again.
PUBLIC_WEBHOOK_URL=

# HTTP port for the local webhook receiver
PORT=8788

# Default directory used by !commands and /session new when no path is given
DEFAULT_DIRECTORY=/home/ubuntu/Oryxa

# Optional default model for newly created sessions (providerID/modelID).
# Overrides the random default so you can pin a model with working credentials.
OPENCODE_MODEL=opencode/hy4-flash-free
